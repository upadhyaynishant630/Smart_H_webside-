{
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/routeTree.gen.ts",
    "vite.config.js",
    "vitest.config.js",
    "eslint.config.js"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals"],

    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
